OPENAI_API_KEY=sk-...

# Local Qdrant from docker-compose. For Qdrant Cloud, swap the URL and add an API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

COLLECTION=docs

# Chunking: fixed | paragraph | sentence | markdown
CHUNK_STRATEGY=paragraph
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# text-embedding-3-small = 1536 dims (cheap, good default)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
