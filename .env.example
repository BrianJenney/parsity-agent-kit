OPENAI_API_KEY=sk-...

# Local Qdrant from docker-compose. For Qdrant Cloud, swap the URL and add an API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

COLLECTION=docs

# Chunking: fixed | paragraph | sentence | markdown
CHUNK_STRATEGY=paragraph
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# text-embedding-3-small = 1536 dims (cheap, good default)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Cheap model for routing, bigger model for judging evals
ROUTER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o

# Observability (curriculum/07). Free account at smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=parsity-agent-kit

# Evals (curriculum/06). Jev is optional: npm run evals -- --judge jev
TYPESAFE_API_KEY=
EVAL_PASS_RATE=0.8

# Voice agent (see VOICE.md). Only needed for npm run voice:server / voice:deploy / voice:call.
RETELL_API_KEY=
AGENT_API_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://your-tunnel.trycloudflare.com
VOICE_PORT=3030
RETELL_PHONE_NUMBER=
RETELL_VOICE_ID=11labs-Adrian
