{
  "name": "parsity-agent-kit",
  "version": "1.0.0",
  "description": "An agent-first AI engineering starter: chunking, RAG, text-to-SQL, agentic retrieval, structured outputs, human in the loop, evals, observability and voice, with skills and challenges your coding agent can teach you from.",
  "type": "module",
  "private": true,
  "scripts": {
    "doctor": "tsx src/doctor.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "chunks": "tsx src/inspect-chunks.ts",
    "ingest": "tsx src/ingest.ts",
    "query": "tsx src/query.ts",
    "fill-form": "tsx src/fill-form.ts",
    "sql:seed": "tsx src/sql/seed.ts",
    "sql:ask": "tsx src/sql/ask.ts",
    "voice:chat": "tsx src/voice/chat.ts",
    "voice:server": "tsx src/voice/server.ts",
    "voice:deploy": "tsx src/voice/deploy.ts",
    "voice:call": "tsx src/voice/call-me.ts",
    "bible:fetch": "tsx src/bible/fetch.ts",
    "bible:fixed": "tsx src/bible/chunk-fixed.ts",
    "bible:smart": "tsx src/bible/chunk-smart.ts",
    "bible:audit": "tsx src/bible/audit.ts",
    "bible:ingest": "tsx src/bible/ingest.ts",
    "agent": "tsx src/agent/cli.ts",
    "hitl:refunds": "tsx src/hitl/refund.ts",
    "evals": "tsx src/evals/run.ts --suite agent",
    "evals:voice": "tsx src/evals/run.ts --suite voice",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "langsmith": "^0.13.1",
    "openai": "^7.62.0",
    "retell-sdk": "^6.2.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
